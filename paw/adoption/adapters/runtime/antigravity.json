  "paths": {
    "local_skills": ".agents/skills/<skill-folder>/SKILL.md",
    "rules": ".agents/rules/*.md",
    "workflows": ".agents/workflows/*.md",
    "artifact_review": "manual-runtime-pass"
  },
  "packaging": {
    "mode": "repo-local-physical-files",
    "installable_files": true,
    "physical_adapter_status": "physical-adapter-candidate",
    "plugin_mode": "distribution-design-candidate",
    "distribution_status": "distribution-design-candidate",
    "distribution_design": "paw/distribution/antigravity-design-candidate.md",
    "distribution_files_materialized": false,
    "distribution_package_format": "unconfirmed"
  },
  "triggers": [
    "manual-agent-task",
    "explicit-opt-in"
