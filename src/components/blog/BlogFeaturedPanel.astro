---
import { Image } from 'astro:assets';
import { t, type SupportedLocale } from '../../utils/i18n';
import {
  blogAngleLabelKey,
  blogCategoryLabelKey,
  blogDomainLabelKey,
  formatBlogDate,
  getBlogPostPath,
  type BlogPostEntry,
} from '../../utils/blog';

interface Props {
  post: BlogPostEntry;
  lang: SupportedLocale;
}

const { post, lang } = Astro.props;
---

<aside class="surface-card blog-featured-card overflow-hidden" data-aos="fade-up" data-aos-delay="120">
  <a href={getBlogPostPath(lang, post.slug)} class="blog-featured-link group flex h-full flex-col">
    <div class="px-5 pt-4 pb-2">
      <span class="section-eyebrow mb-0">{t('blog.featuredTitle', lang)}</span>
    </div>

    <div class="blog-featured-shell">
      <Image
        src={post.data.header_image}
        alt={post.data.title}
        class="blog-card-image"
        widths={[720, 1080]}
        sizes="(min-width: 1024px) 24rem, 100vw"
      />
      <div class="blog-featured-overlay" aria-hidden="true"></div>
    </div>

    <div class="px-5 pt-4 md:px-6">
      <p class="meta-kicker text-xs font-mono uppercase tracking-[0.16em]">
        {formatBlogDate(post.data.publish_date, lang)}
      </p>
    </div>

    <div class="flex flex-1 flex-col px-5 pb-5 pt-4 md:px-6 md:pb-6">
      <h2 class="mb-4 font-heading text-2xl text-secondary dark:text-fog">
        {post.data.title}
      </h2>

      <div class="mb-2 flex flex-wrap items-center gap-2">
        <span class="tag-chip">{t(blogCategoryLabelKey[post.data.category], lang)}</span>
      </div>
      <div class="mb-4 flex flex-wrap items-center gap-2">
        <span class="tag-chip tag-chip-secondary">{t(blogAngleLabelKey[post.data.angle], lang)}</span>
        <span class="tag-chip tag-chip-secondary">{t(blogDomainLabelKey[post.data.domain], lang)}</span>
      </div>

      <p class="featured-card-excerpt text-tone-soft mb-5">
        {post.data.excerpt}
      </p>

      <span class="mt-auto inline-flex items-center gap-2 text-sm font-medium text-primary transition-colors duration-300 group-hover:text-secondary dark:group-hover:text-fog">
        <span>{t('blog.readArticle', lang)}</span>
        <span aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</aside>
