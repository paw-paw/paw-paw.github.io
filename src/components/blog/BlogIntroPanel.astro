---
import { t, type SupportedLocale } from '../../utils/i18n';
import EditorialBackgroundStrip from './EditorialBackgroundStrip.astro';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
---

<div class="surface-muted blog-intro-panel px-6 py-8 md:px-10 md:py-12" data-aos="fade-up">
  <span class="section-eyebrow">{t('blog.eyebrow', lang)}</span>
  <h1 class="font-heading text-h1 text-secondary dark:text-fog mb-5">{t('blog.title', lang)}</h1>

  <div class="blog-intro-copy">
    <p>{t('blog.introParagraph1', lang)}</p>
    <p>{t('blog.introParagraph2', lang)}</p>
  </div>

  <EditorialBackgroundStrip lang={lang} />

  <a href="#latest-writing" class="blog-intro-explore-link">
    <span>{t('blog.exploreArticles', lang)}</span>
    <span aria-hidden="true">↓</span>
  </a>
</div>
